{
  "name": "orders-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Shopify -> QuickBooks Online order sync with bundle decomposition",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev:web": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:web": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
