# Postgres (Neon). Plain connection string, no Neon-specific tooling.
# sslmode=verify-full (not "require") avoids a pg deprecation warning --
# "require" is currently aliased to verify-full but a future pg major
# version will weaken it to no cert verification unless set explicitly.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=verify-full

# Shopify
SHOPIFY_API_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# QuickBooks Online (sandbox first)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=http://localhost:3000/quickbooks/callback

# Fly.io Machines API (used by the web process to wake the worker)
FLY_API_TOKEN=
FLY_APP_NAME=
FLY_WORKER_MACHINE_ID=

PORT=3000
